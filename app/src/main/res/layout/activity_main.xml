

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="NJA Clicker"
            android:textSize="30sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Auto Clicker &amp; Auto Swipe"
            android:textSize="16sp"
            android:gravity="center"
            android:paddingBottom="30dp" />

        <TextView
            android:id="@+id/tvServiceStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Accessibility Service: Disabled"
            android:textSize="16sp"
            android:padding="12dp" />

        <Button
            android:id="@+id/btnEnableService"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enable Accessibility Service" />

        <View
            android:layout_width="match_parent"
            android:layout_height="20dp" />

        <Button
            android:id="@+id/btnOpenFloatingControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Open Floating Controls" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="How to use"
            android:textStyle="bold"
            android:textSize="18sp"
            android:paddingTop="28dp"
            android:paddingBottom="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. Enable the Accessibility Service.\n\n2. Open Floating Controls.\n\n3. Configure your click and swipe positions.\n\n4. Start your automation."
            android:textSize="15sp"
            android:lineSpacingExtra="5dp" />

    </LinearLayout>

</ScrollView>
